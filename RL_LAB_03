      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "# Part A: Machine initialization\n",
        "machines = [\"A\", \"B\", \"C\"]\n",
        "\n",
        "# N = number of plays, R = total reward, Q = estimated average reward\n",
        "N = {machine: 0 for machine in machines}\n",
        "R = {machine: 0.0 for machine in machines}\n",
        "Q = {machine: 0.0 for machine in machines}\n",
        "\n",
        "epsilon = 0.2\n",
        "total_reward = 0.0\n",
        "\n",
        "print(\"Modified Epsilon-Greedy Multi-Armed Bandit\")\n",
        "print(\"Number of plays: 10\")\n",
        "print(\"Epsilon:\", epsilon)\n",
        "print(\"\\nSuggested reward patterns:\")\n",
        "print(\"A: 3, 4, 2, 5\")\n",
        "print(\"B: 6, 7, 5, 8\")\n",
        "print(\"C: 4, 3, 5, 4\")\n",
        "\n",
        "for play in range(1, 11):\n",
        "    # Find a machine with the highest Q-value.\n",
        "        # random.choice handles ties fairly when all Q-values are equal.\n",
        "            highest_q = max(Q.values())\n",
        "                best_machines = [m for m in machines if Q[m] == highest_q]\n",
        "                    best_machine = random.choice(best_machines)\n",
        "\n",
        "                        r = random.random()\n",
        "\n",
        "                            # Part C: Modified epsilon-greedy decision\n",
        "                                if r < epsilon:\n",
        "                                        # Exploration: choose any machine except the current best machine\n",
        "                                                other_machines = [m for m in machines if m != best_machine]\n",
        "                                                        selected_machine = random.choice(other_machines)\n",
        "                                                                decision = \"Exploration\"\n",
        "                                                                    else:\n",
        "                                                                            # Exploitation: choose the machine with highest Q-value\n",
        "                                                                                    selected_machine = best_machine\n",
        "                                                                                            decision = \"Exploitation\"\n",
        "\n",
        "                                                                                                print(f\"\\nPlay {play}: {decision}\")\n",
        "                                                                                                    print(\"Selected machine:\", selected_machine)\n",
        "\n",
        "                                                                                                        # Part D: Reward collection\n",
        "                                                                                                            reward = float(input(\"Enter reward: \"))\n",
        "\n",
        "                                                                                                                # Part E: Incremental sample-average Q update\n",
        "                                                                                                                    N[selected_machine] += 1\n",
        "                                                                                                                        R[selected_machine] += reward\n",
        "\n",
        "                                                                                                                            Q[selected_machine] = Q[selected_machine] + (\n",
        "                                                                                                                                    reward - Q[selected_machine]\n",
        "                                                                                                                                        ) / N[selected_machine]\n",
        "\n",
        "                                                                                                                                            total_reward += reward\n",
        "\n",
        "                                                                                                                                            # Part F: Display final tables\n",
        "                                                                                                                                            print(\"\\n--- Final N, R, Q Tables ---\")\n",
        "                                                                                                                                            print(\"Machine\\tN (plays)\\tR (total reward)\\tQ (average reward)\")\n",
        "\n",
        "                                                                                                                                            for machine in machines:\n",
        "                                                                                                                                                print(f\"{machine}\\t{N[machine]}\\t\\t{R[machine]:.2f}\\t\\t\\t{Q[machine]:.2f}\")\n",
        "\n",
        "                                                                                                                                                print(\"\\nTotal reward received by the player:\", total_reward)"
