      "source": [
        "import math\n",
        "\n",
        "# Machine Initialization\n",
        "machines = ['A', 'B', 'C']\n",
        "\n",
        "# Number of plays\n",
        "N_play = 7\n",
        "\n",
        "# Initialize N, R, Q and UCB\n",
        "N = [0, 0, 0]\n",
        "R = [0, 0, 0]\n",
        "Q = [0.0, 0.0, 0.0]\n",
        "UCB = [0.0, 0.0, 0.0]\n",
        "\n",
        "# Static rewards for 7 plays\n",
        "rewards = [3, 6, 4, 7, 5, 8, 6]\n",
        "\n",
        "# Play for 7 times\n",
        "for t in range(1, N_play + 1):\n",
        "\n",
        "    # Calculate UCB\n",
        "        for i in range(3):\n",
        "                if N[i] == 0:\n",
        "                            UCB[i] = float('inf')\n",
        "                                    else:\n",
        "                                                UCB[i] = Q[i] + math.sqrt((2 * math.log(t)) / N[i])\n",
        "\n",
        "                                                    # Select machine with highest UCB\n",
        "                                                        selected = UCB.index(max(UCB))\n",
        "\n",
        "                                                            # Get static reward\n",
        "                                                                reward = rewards[t - 1]\n",
        "\n",
        "                                                                    # Update count\n",
        "                                                                        N[selected] += 1\n",
        "\n",
        "                                                                            # Update total reward\n",
        "                                                                                R[selected] += reward\n",
        "\n",
        "                                                                                    # Update Q-value\n",
        "                                                                                        Q[selected] = Q[selected] + \\\n",
        "                                                                                                          (reward - Q[selected]) / N[selected]\n",
        "\n",
        "                                                                                                              print(\"Play\", t,\n",
        "                                                                                                                        \"Machine:\", machines[selected],\n",
        "                                                                                                                                  \"Reward:\", reward)\n",
        "\n",
        "                                                                                                                                  # Display final results\n",
        "                                                                                                                                  print(\"\\nFinal Results\")\n",
        "                                                                                                                                  print(\"-------------------------\")\n",
        "\n",
        "                                                                                                                                  for i in range(3):\n",
        "                                                                                                                                      print(\"Machine:\", machines[i])\n",
        "                                                                                                                                          print(\"N =\", N[i])\n",
        "                                                                                                                                              print(\"R =\", R[i])\n",
        "                                                                                                                                                  print(\"UCB =\", round(UCB[i], 3))\n",
        "                                                                                                                                                      print(\"Q =\", round(Q[i], 3))\n",
        "                                                                                                                                                          print()\n",
        "\n",
        "                                                                                                                                                          print(\"Total Reward =\", sum(R))"
